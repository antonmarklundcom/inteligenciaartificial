# Copy to .env and fill in. Never commit real values.

# MySQL 8 connection — the app's own runtime user (table-scoped privileges;
# see scripts/db-grants.ts, which makes audit_logs append-only for this user).
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=inteligenciaartificial
DATABASE_PASSWORD=
DATABASE_NAME=inteligenciaartificial

# Optional: a privileged user used only by scripts/db-migrate.ts and
# scripts/db-grants.ts to run DDL and issue grants. Falls back to
# DATABASE_USER when unset (fine for local/CI where that user has
# GRANT OPTION). On Hostinger, leave unset — see scripts/db-grants.ts.
ADMIN_DATABASE_USER=
ADMIN_DATABASE_PASSWORD=

# Host mask used when granting privileges to DATABASE_USER (default '%').
DATABASE_USER_HOST=%

# Shared secret required on the Authorization header of the cron-invoked job worker route.
JOB_WORKER_SECRET=

# Base URL used to build absolute links in emails and signed URLs.
APP_BASE_URL=http://localhost:3000
